{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run bundle",
  "outputDirectory": "public",
  "git": { "deploymentEnabled": { "*": false, "**": false, "main": true } },
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ../../packages ../../package.json ../../package-lock.json || exit 1",
  "regions": ["cle1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
