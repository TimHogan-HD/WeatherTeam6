{
  "name": "@weatherteam6/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "node --eval \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "user:add": "tsx src/scripts/addUser.ts",
    "probe:models": "tsx src/scripts/probeModels.ts",
    
    
    "check:auth": "tsx src/scripts/checkAuth.ts",
    "check:add-location": "tsx src/scripts/checkAddLocationApi.ts",
    
    "check:conditions": "tsx src/scripts/checkConditions.ts",
    "check:delete-trip": "tsx src/scripts/checkDeleteTrip.ts",
    
    "check:weather-runs": "tsx src/scripts/checkWeatherRuns.ts",
    "check:hourly": "tsx src/scripts/checkHourly.ts",
    "check:runs-storage": "tsx src/scripts/checkRunsStorage.ts",
    "compare:scoring": "tsx src/scripts/compareScoring.ts",
    "compare:hourly-v2": "tsx src/scripts/compareHourlyV2.ts",
    "compare:thermal": "tsx src/scripts/compareThermal.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@weatherteam6/types": "*",
    "drizzle-orm": "^0.41.0",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^5.9.1",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.0.0"
  }
}
