{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The base config targets Node (module/moduleResolution NodeNext). Vite
    // bundles, so the app resolves like a bundler and emits nothing itself.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client"],
    "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
