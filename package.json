{
  "name": "weatherteam6",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "npm run -w apps/api db:generate",
    "db:migrate": "npm run -w apps/api db:migrate",
    "db:studio": "npm run -w apps/api db:studio",
    "check:hooks": "node .claude/hooks/check-hooks.mjs",
    "check:crag-facts": "node scripts/check-crag-facts.mjs",
    "check:icons": "node apps/miniapp/scripts/check-icons.mjs",
    "wait:pr": "node .claude/hooks/wait-pr.mjs"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "turbo": "^2.11.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@10.9.7"
}
