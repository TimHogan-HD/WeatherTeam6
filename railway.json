{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run build --workspace=@weatherteam6/types && npm run build --workspace=@weatherteam6/api"
  },
  "deploy": {
    "startCommand": "npm run db:migrate --workspace=@weatherteam6/api && node apps/api/dist/server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
