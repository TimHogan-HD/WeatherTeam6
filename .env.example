# The authoritative list of environment variables. Set them in your shell for the
# one command that needs them — do not create a .env file.
#
# Which are credentials, which reach a public bundle, which are fail-closed, and
# why NODE_ENV must never be set on Vercel: CLAUDE.md § Environment Variables.

DATABASE_URL=
DEFAULT_USER_ID=
API_SHARED_SECRET=
AUTH_TOKEN_SECRET=
CRON_SECRET=
CORS_ALLOWED_ORIGINS=
NWS_USER_AGENT=weatherteam6/1.0 your@email.com
NODE_ENV=development
PORT=3001
LOG_LEVEL=

# Client (apps/miniapp). Inlined into a PUBLIC bundle at build time — never a credential.
VITE_API_BASE_URL=
